{
  "expo": {
    "name": "Sloucy",
    "slug": "Sloucy",
    "version": "1.4.0",
    "icon": "./assets/icon.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "5",
      "bundleIdentifier": "se.alphamou.sloucy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [],
      "versionCode": 11,
      "package": "se.alphamou.sloucy"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "74069b57-8719-4165-b88d-7ffb5c45750e"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "ios": {
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      "expo-status-bar"
    ]
  }
}
